{
  "manifest_version": 3,
  "name": "豆包图片视频去水印",
  "short_name": "DoubaoWaterMark-Remover",
  "description": "在豆包对话页一键获取无水印原图与高清无水印视频，支持本地媒体管理。",
  "version": "2.4.5",
  "minimum_chrome_version": "111",
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.doubao.com/*",
    "https://*.byteimg.com/*",
    "https://*.snssdk.com/*",
    "https://*.byteintlapi.com/*",
    "https://*.douyin.com/*",
    "https://*.douyinpic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "豆包图片视频去水印"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.doubao.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*.doubao.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
